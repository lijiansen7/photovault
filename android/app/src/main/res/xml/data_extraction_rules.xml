<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup 已经关掉整包备份，这里再显式兜一层：
     Android 12+ 的「设备间迁移」走的是 data-extraction-rules，不写就会
     把 DataStore 里的 token 和（加密后的）密码一起带到新手机上。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

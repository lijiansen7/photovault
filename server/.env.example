# 初始管理员 admin 的密码（首次启动创建时用；同时也是旧版单一 Token 的值）
# 升级后建议只把它当初始密码用，日常走账号密码登录。
ACCESS_TOKEN=photovault

# 旧版单一 Token 通道。**默认已关闭**，App 只能账号登录。
# 设成 1 才会重新接受用 ACCESS_TOKEN 直连（应急用，别长期开着）。
ALLOW_LEGACY_TOKEN=0

# 首次启动自动创建的管理员（库里一个用户都没有时才会建）
INIT_ADMIN_USER=admin
INIT_ADMIN_PASSWORD=photovault

# token 有效期（小时），默认 720 = 30 天
TOKEN_TTL_HOURS=720

# 签名密钥。留空会自动生成并存在数据目录的 .secret 里。
# 多副本部署时必须显式指定成同一个值，否则登录态不通用。
SECRET_KEY=

TZ=Asia/Shanghai
MAX_UPLOAD_MB=1024
THUMB_SIZE=512
ENABLE_THUMB=1
LOG_LEVEL=INFO

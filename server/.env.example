# 初始管理员 admin 的密码（首次启动创建时用；同时也是旧版单一 Token 的值）
# 升级后建议只把它当初始密码用，日常走账号密码登录。
ACCESS_TOKEN=photovault

# 旧版单一 Token 通道。**默认已关闭**，App 只能账号登录。
# 设成 1 才会重新接受用 ACCESS_TOKEN 直连（应急用，别长期开着）。
ALLOW_LEGACY_TOKEN=0

# 首次启动自动创建的管理员（库里一个用户都没有时才会建）
INIT_ADMIN_USER=admin
INIT_ADMIN_PASSWORD=photovault
# 密码最短长度（新账号/改密生效；老账号不受影响）
MIN_PASSWORD_LEN=8

# token 有效期（小时），默认 720 = 30 天
TOKEN_TTL_HOURS=720
# 登录限流：同一 IP 5 分钟内最多尝试多少次
LOGIN_RATE_LIMIT=60
# PBKDF2 迭代次数（越大越慢越安全）
PBKDF2_ITERS=600000

# 签名密钥。留空会自动生成并存在数据目录的 .secret 里。
# 多副本部署时必须显式指定成同一个值，否则登录态不通用。
SECRET_KEY=

# 旧版 App 把 token 拼在图片 URL 上（?token=）。只对媒体 GET 生效，
# 给已安装的旧 APK 留一个版本；全部升级后设 0。
ALLOW_LEGACY_MEDIA_TOKEN=1

TZ=Asia/Shanghai
# 单文件上限（MB）。0 = 不限制；默认 4096 兜底
MAX_UPLOAD_MB=4096
# 每用户配额（GB），0 = 不限制
USER_QUOTA_GB=0
# 磁盘剩余低于此值（MB）时拒绝上传
MIN_FREE_MB=512
THUMB_SIZE=512
ENABLE_THUMB=1
# /docs 与 openapi.json 默认关闭
ENABLE_DOCS=0
LOG_LEVEL=INFO
